{
  "name": "yuzutrends",
  "version": "0.2.4-20260401",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "CF_PAGES_COMMIT_SHA=$CF_PAGES_COMMIT_SHA react-router build",
    "dev": "react-router dev",
    "start": "react-router-serve ./build/server/index.js",
    "cloudflare_start": "pnpm wrangler dev",
    "typecheck": "react-router typegen && tsc",
    "obfuscate": "javascript-obfuscator ./build/client/assets --output ./build/client/assets --log false --string-array true --self-defending true",
    "prettier": "pnpx prettier --write .",
    "esbuild": "pnpx esbuild ./build/server/index.js --bundle --splitting --minify --tree-shaking=true --platform=node --target=node24 --format=esm --outdir=./build/server/dist --external:'node:*' --external:aws-sdk --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" && "
  },
  "dependencies": {
    "@cloudflare/vite-plugin": "^1.30.3",
    "@geostrategists/react-router-aws": "^2.2.1",
    "@react-router/node": "^7.13.2",
    "@react-router/serve": "^7.13.2",
    "d3-dsv": "^3.0.1",
    "devtools-detector": "^2.0.25",
    "driver.js": "^1.4.0",
    "es-hangul": "^2.3.8",
    "i18next": "^26.0.3",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-fetch-backend": "^7.0.0",
    "isbot": "^5.1.37",
    "papaparse": "^5.5.3",
    "plotly.js": "^3.4.0",
    "posthog-js": "^1.364.4",
    "pretty-cache-header": "^1.0.0",
    "rc-slider": "^11.1.9",
    "rc-tooltip": "^6.4.0",
    "rc-util": "^5.44.4",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-i18next": "^17.0.2",
    "react-icons": "^5.6.0",
    "react-plotly.js": "^2.6.0",
    "react-router": "^7.13.2",
    "recharts": "^3.8.1",
    "remix-i18next": "^7.4.2",
    "wanakana": "^5.3.1",
    "xz-decompress": "^0.2.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260401.1",
    "@react-router/dev": "^7.13.2",
    "@tailwindcss/vite": "^4.2.2",
    "@types/d3-dsv": "^3.0.7",
    "@types/node": "^25.5.0",
    "@types/papaparse": "^5.5.2",
    "@types/plotly.js": "^3.0.10",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/react-plotly.js": "^2.6.4",
    "javascript-obfuscator": "^5.4.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-tsconfig-paths": "^6.1.1",
    "wrangler": "^4.79.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
