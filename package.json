    "diff": "^9.0.0",
    "dompurify": "^3.4.14",
    "driver.js": "^1.8.0",
    "es-hangul": "^2.4.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "^5.22.0",
    "i18next": "^26.4.0",
    "i18next-browser-languagedetector": "^8.2.1",
