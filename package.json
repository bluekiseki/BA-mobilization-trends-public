{
  "name": "yuzutrends",
  "version": "0.3.3-20260823",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-sitemap.mjs && node scripts/generate-locale-static.mjs && CF_PAGES_COMMIT_SHA=$CF_PAGES_COMMIT_SHA react-router build",
    "copy-ort-wasm": "node scripts/copy-ort-wasm.mjs",
    "dev": "node scripts/generate-locale-static.mjs && react-router dev --host",
    "dev:cdn": "node scripts/generate-locale-static.mjs && VITE_USE_CDN=true react-router dev --host",
    "dev:auth": "pnpx wrangler dev -c wrangler.auth.jsonc --port 8787",
    "deploy:auth": "wrangler deploy --config wrangler.auth.jsonc",
    "start": "react-router-serve ./build/server/index.js",
    "cloudflare_start": "pnpm wrangler dev",
    "type-check": "tsc --noEmit",
    "test:auth": "bash tests/auth.sh",
    "lint": "eslint app workers",
    "test": "vitest run",
    "prettier": "pnpx prettier --write ."
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "^1.7.1",
