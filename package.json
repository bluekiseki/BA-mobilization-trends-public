{
  "name": "yuzutrends",
  "version": "0.4.0-20261024",
  "private": true,
  "sideEffects": false,
  "type": "module",
  "scripts": {
    "build": "node scripts/generate-sitemap.mjs && node scripts/generate-locale-static.mjs && node scripts/generate-text-feeds.mjs && CF_PAGES_COMMIT_SHA=$CF_PAGES_COMMIT_SHA react-router build",
    "copy-ort-wasm": "node scripts/copy-ort-wasm.mjs",
    "dev": "node scripts/generate-locale-static.mjs && node scripts/generate-text-feeds.mjs && node scripts/copy-ort-wasm.mjs && react-router dev --host",
    "dev:cdn": "node scripts/generate-locale-static.mjs && node scripts/generate-text-feeds.mjs && VITE_USE_CDN=true react-router dev --host",
    "dev:auth": "pnpx wrangler dev -c wrangler.auth.jsonc --port 8787",
    "deploy:auth": "wrangler deploy --config wrangler.auth.jsonc",
    "start": "react-router-serve ./build/server/index.js",
    "cloudflare_start": "pnpm wrangler dev",
    "type-check": "tsc --noEmit",
    "test:auth": "bash tests/auth.sh",
    "lint": "eslint app workers && pnpm check:arch && pnpm check:specifiers",
    "check:specifiers": "node scripts/check-specifiers.mjs",
    "check:arch": "depcruise app workers --config scripts/dependency-cruiser.config.cjs --ignore-known",
    "check:arch:baseline": "depcruise app workers --config scripts/dependency-cruiser.config.cjs --output-type baseline > .dependency-cruiser-known-violations.json",
    "test": "vitest run",
    "prettier": "pnpx prettier --write ."
  },
  "dependencies": {
    "@better-auth/kysely-adapter": "^1.7.12",
    "@better-auth/passkey": "^1.7.12",
    "@cloudflare/vite-plugin": "^1.65.0",
    "@geostrategists/react-router-aws": "^3.0.0",
    "@react-router/node": "^8.5.0",
    "@react-router/serve": "^8.5.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@zxcvbn-ts/core": "^4.2.0",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "@zxcvbn-ts/language-en": "^4.1.1",
    "better-auth": "^1.7.12",
    "d3-drag": "^3.0.0",
    "d3-dsv": "^3.0.1",
    "d3-force": "^3.0.0",
    "d3-selection": "^3.0.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "devtools-detector": "^2.0.25",
    "diff": "^9.0.0",
    "dompurify": "^3.4.17",
    "driver.js": "^1.10.2",
    "es-hangul": "^2.4.0",
    "graphql": "^17.0.2",
    "graphql-yoga": "6.0.0",
    "i18next": "^26.5.6",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-fetch-backend": "^8.0.0",
    "isbot": "^5.2.2",
    "mediabunny": "^1.62.1",
    "onnxruntime-web": "^1.30.0",
    "papaparse": "^5.7.0",
    "plotly.js": "^4.1.2",
    "posthog-js": "^1.438.21",
    "rc-slider": "^11.1.9",
    "rc-tooltip": "^6.4.0",
    "rc-util": "^5.44.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.1.4",
    "react-icons": "^5.7.0",
    "react-plotly.js": "^4.1.0",
    "react-router": "^8.5.0",
    "recharts": "^3.10.1",
    "remix-i18next": "^8.0.0",
    "wanakana": "^5.3.1",
    "xz-decompress": "^0.2.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/d3-drag": "^3.0.7",
    "@types/d3-dsv": "^3.0.7",
    "@types/d3-force": "^3.0.10",
    "@types/d3-selection": "^3.0.12",
    "@types/d3-transition": "^3.0.9",
    "@types/d3-zoom": "^3.0.9",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/plotly.js": "^3.0.15",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-plotly.js": "^2.6.4",
    "dependency-cruiser": "^18.7.0",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "javascript-obfuscator": "^5.9.0",
    "jsdom": "^30.1.3",
    "playwright": "^1.64.1",
    "rollup-plugin-visualizer": "^7.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
