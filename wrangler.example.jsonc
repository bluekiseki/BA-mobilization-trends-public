{
  "name": "your-worker-name",
  "compatibility_date": "2026-01-03",
  "main": "./workers/app.ts",
  "assets": {
    "directory": "./build/client",
    "binding": "ASSETS",
  },
  // Per-IP limit for the dynamic notices text feed (workers/textFeedGuard.ts); keep in sync with
  // TEXT_FEED_RATE_LIMIT (app/data/textFeeds.meta.ts). Static /txt feeds need no Worker.
  "ratelimits": [{ "name": "TEXT_NOTICES_LIMITER", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }],
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true,
      "persist": true,
    },
  },
  "vars": {
    "VITE_TURNSTILE_SITE_KEY": "your-turnstile-site-key",
    "VITE_PUBLIC_POSTHOG_KEY": "your-posthog-public-key",
    "VITE_PUBLIC_POSTHOG_DIRECT_HOST": "https://us.i.posthog.com",
    "VITE_PUBLIC_POSTHOG_UI_HOST": "https://us.posthog.com",
    "VITE_PUBLIC_POSTHOG_HOST": "https://your-posthog-proxy-host",
    "VITE_WEB3FORMS_ACCESS_KEY": "your-web3forms-access-key",
    "GITHUB_CLIENT_ID": "your-github-oauth-client-id",
    "ENVIRONMENT": "production",
  },
  "preview_urls": false,
  "workers_dev": false,
  "r2_buckets": [
    {
      "binding": "MY_BUCKET",
      "bucket_name": "your-r2-bucket-name",
    },
  ],
  "services": [
    {
      "binding": "AUTH_WORKER",
      "service": "your-auth-worker-name",
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "your-db-name",
      "database_id": "00000000-0000-0000-0000-000000000001",
    },
    {
      "binding": "ba_user",
      "database_name": "your-user-db-name",
      "database_id": "00000000-0000-0000-0000-000000000002",
      "migrations_dir": "db/auth",
    },
  ],
}
